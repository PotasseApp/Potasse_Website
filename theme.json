{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{
					"slug": "base",
					"name": "Crème terre",
					"color": "#F5E9D7"
				},
				{
					"slug": "contrast",
					"name": "Noir profond",
					"color": "#1C1C1C"
				},
				{
					"slug": "accent-1",
					"name": "Vert sapin",
					"color": "#3E5C2C"
				},
				{
					"slug": "accent-2",
					"name": "Vert kaki",
					"color": "#7A9B4F"
				},
				{
					"slug": "accent-3",
					"name": "Bois miel",
					"color": "#D9B98C"
				},
				{
					"slug": "accent-4",
					"name": "Brun terre",
					"color": "#6B4423"
				},
				{
					"slug": "accent-5",
					"name": "Crème claire",
					"color": "#FBF5EC"
				},
				{
					"slug": "accent-6",
					"name": "Sable",
					"color": "#EADBC4"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "instrument-serif",
					"name": "Instrument Serif",
					"fontFamily": "\"Instrument Serif\", Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Instrument Serif",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/instrument-serif/instrument-serif-latin-400-normal.woff2"
							]
						},
						{
							"fontFamily": "Instrument Serif",
							"fontStyle": "italic",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/instrument-serif/instrument-serif-latin-400-italic.woff2"
							]
						}
					]
				},
				{
					"slug": "dm-sans",
					"name": "DM Sans",
					"fontFamily": "\"DM Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "DM Sans",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/dm-sans/dm-sans-latin-400-normal.woff2"
							]
						},
						{
							"fontFamily": "DM Sans",
							"fontStyle": "italic",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/dm-sans/dm-sans-latin-400-italic.woff2"
							]
						},
						{
							"fontFamily": "DM Sans",
							"fontStyle": "normal",
							"fontWeight": "500",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/dm-sans/dm-sans-latin-500-normal.woff2"
							]
						},
						{
							"fontFamily": "DM Sans",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/dm-sans/dm-sans-latin-700-normal.woff2"
							]
						}
					]
				},
				{
					"slug": "caveat",
					"name": "Caveat",
					"fontFamily": "Caveat, \"Comic Sans MS\", cursive",
					"fontFace": [
						{
							"fontFamily": "Caveat",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/caveat/caveat-latin-400-normal.woff2"
							]
						},
						{
							"fontFamily": "Caveat",
							"fontStyle": "normal",
							"fontWeight": "600",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/caveat/caveat-latin-600-normal.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Petit",
					"size": "0.9375rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Normal",
					"size": "1.0625rem",
					"fluid": {
						"min": "1rem",
						"max": "1.125rem"
					}
				},
				{
					"slug": "large",
					"name": "Grand",
					"size": "1.375rem",
					"fluid": {
						"min": "1.25rem",
						"max": "1.5rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Très grand",
					"size": "2rem",
					"fluid": {
						"min": "1.75rem",
						"max": "2.5rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "Titre",
					"size": "3rem",
					"fluid": {
						"min": "2.375rem",
						"max": "4rem"
					}
				}
			]
		},
		"layout": {
			"contentSize": "640px",
			"wideSize": "1100px"
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|dm-sans",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var:preset|color|accent-1"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|instrument-serif",
					"fontWeight": "400",
					"lineHeight": "1.1",
					"letterSpacing": "-0.01em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "clamp(1.5rem, 1.35rem + 0.6vw, 1.875rem)"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|accent-1"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|accent-4"
					}
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|accent-1",
					"text": "var:preset|color|base"
				},
				"border": {
					"radius": "999px"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"bottom": "0.75rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|dm-sans",
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "700"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|contrast",
						"text": "var:preset|color|base"
					}
				}
			}
		},
		"blocks": {
			"core/details": {
				"border": {
					"bottom": {
						"color": "var:preset|color|accent-3",
						"width": "1px",
						"style": "solid"
					}
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"bottom": "0.75rem"
					}
				}
			},
			"core/separator": {
				"color": {
					"background": "var:preset|color|accent-3",
					"text": "var:preset|color|accent-3"
				}
			}
		}
	}
}
